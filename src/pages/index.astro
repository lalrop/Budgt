---
const title = 'Budgt — En construcción';
const description = 'Estamos trabajando en el nuevo sitio de Budgt. Vuelve pronto.';
const site = 'https://budgt.cl';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}/logo-budgt.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <img
        src="/logo-budgt.png"
        alt="Budgt"
        width="700"
        height="428"
        fetchpriority="high"
      />
      <h1>En construcción</h1>
      <p>Estamos preparando algo nuevo. Vuelve pronto.</p>
    </main>
    <footer>budgt.cl</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f3f1;
    --ink: #0a0a0a;
    --muted: #6b6b6b;
    --font-serif: 'DM Serif Display', Georgia, serif;
    --font-sans: 'DM Sans', system-ui, -apple-system, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding: 2.5rem 1.5rem;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    line-height: 1.6;
    text-align: center;
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 32rem;
  }

  img {
    width: min(320px, 72vw);
    height: auto;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  p {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  footer {
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
